<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_demo_cinema"
        android:label="@string/demo_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Demo">

        <activity
            android:name=".DemoActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity-alias
            android:name=".Cinema"
            android:exported="true"
            android:icon="@drawable/ic_demo_cinema"
            android:label="影院"
            android:targetActivity=".DemoActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Music"
            android:exported="true"
            android:icon="@drawable/ic_demo_music"
            android:label="音乐"
            android:targetActivity=".DemoActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Live"
            android:exported="true"
            android:icon="@drawable/ic_demo_live"
            android:label="直播"
            android:targetActivity=".DemoActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Gallery"
            android:exported="true"
            android:icon="@drawable/ic_demo_gallery"
            android:label="相册"
            android:targetActivity=".DemoActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Games"
            android:exported="true"
            android:icon="@drawable/ic_demo_games"
            android:label="游戏"
            android:targetActivity=".DemoActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
